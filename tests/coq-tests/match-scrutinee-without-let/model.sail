default Order dec
$include <prelude.sail>

type regidx = bits(5)

// A match on a computed value: Sail names it (let x = f(o) in match x), the translation matches on f(o)
val twice : option(bits(8)) -> option(bits(8))
function twice(o) = o

val pick : option(bits(8)) -> bits(8)
function pick(o) = match twice(o) { Some(x) => x, None() => 0x00 }

// A decoder like sail-riscv's encdec_backwards: one match per encoding, nested in the previous one's last case
union ast = {
  C0 : (regidx, bits(12)),
  C1 : (regidx, bits(12)),
  C2 : (regidx, bits(12)),
  C3 : (regidx, bits(12)),
  C4 : (regidx, bits(12)),
  C5 : (regidx, bits(12)),
  C6 : (regidx, bits(12)),
  C7 : (regidx, bits(12)),
  C8 : (regidx, bits(12)),
  C9 : (regidx, bits(12)),
  C10 : (regidx, bits(12)),
  C11 : (regidx, bits(12)),
  C12 : (regidx, bits(12)),
  C13 : (regidx, bits(12)),
  C14 : (regidx, bits(12)),
  C15 : (regidx, bits(12)),
  C16 : (regidx, bits(12)),
  C17 : (regidx, bits(12)),
  C18 : (regidx, bits(12)),
  C19 : (regidx, bits(12)),
  C20 : (regidx, bits(12)),
  C21 : (regidx, bits(12)),
  C22 : (regidx, bits(12)),
  C23 : (regidx, bits(12)),
  C24 : (regidx, bits(12)),
  C25 : (regidx, bits(12)),
  C26 : (regidx, bits(12)),
  C27 : (regidx, bits(12)),
  C28 : (regidx, bits(12)),
  C29 : (regidx, bits(12)),
  C30 : (regidx, bits(12)),
  C31 : (regidx, bits(12)),
  C32 : (regidx, bits(12)),
  C33 : (regidx, bits(12)),
  C34 : (regidx, bits(12)),
  C35 : (regidx, bits(12)),
  C36 : (regidx, bits(12)),
  C37 : (regidx, bits(12)),
  C38 : (regidx, bits(12)),
  C39 : (regidx, bits(12)),
  C40 : (regidx, bits(12)),
  C41 : (regidx, bits(12)),
  C42 : (regidx, bits(12)),
  C43 : (regidx, bits(12)),
  C44 : (regidx, bits(12)),
  C45 : (regidx, bits(12)),
  C46 : (regidx, bits(12)),
  C47 : (regidx, bits(12)),
  C48 : (regidx, bits(12)),
  C49 : (regidx, bits(12)),
  C50 : (regidx, bits(12)),
  C51 : (regidx, bits(12)),
  C52 : (regidx, bits(12)),
  C53 : (regidx, bits(12)),
  C54 : (regidx, bits(12)),
  C55 : (regidx, bits(12)),
  C56 : (regidx, bits(12)),
  C57 : (regidx, bits(12)),
  C58 : (regidx, bits(12)),
  C59 : (regidx, bits(12))
}

mapping encdec : ast <-> bits(32) = {
  C0(rd, imm) <-> imm @ rd @ 0b000000000000000,
  C1(rd, imm) <-> imm @ rd @ 0b000000000000001,
  C2(rd, imm) <-> imm @ rd @ 0b000000000000010,
  C3(rd, imm) <-> imm @ rd @ 0b000000000000011,
  C4(rd, imm) <-> imm @ rd @ 0b000000000000100,
  C5(rd, imm) <-> imm @ rd @ 0b000000000000101,
  C6(rd, imm) <-> imm @ rd @ 0b000000000000110,
  C7(rd, imm) <-> imm @ rd @ 0b000000000000111,
  C8(rd, imm) <-> imm @ rd @ 0b000000000001000,
  C9(rd, imm) <-> imm @ rd @ 0b000000000001001,
  C10(rd, imm) <-> imm @ rd @ 0b000000000001010,
  C11(rd, imm) <-> imm @ rd @ 0b000000000001011,
  C12(rd, imm) <-> imm @ rd @ 0b000000000001100,
  C13(rd, imm) <-> imm @ rd @ 0b000000000001101,
  C14(rd, imm) <-> imm @ rd @ 0b000000000001110,
  C15(rd, imm) <-> imm @ rd @ 0b000000000001111,
  C16(rd, imm) <-> imm @ rd @ 0b000000000010000,
  C17(rd, imm) <-> imm @ rd @ 0b000000000010001,
  C18(rd, imm) <-> imm @ rd @ 0b000000000010010,
  C19(rd, imm) <-> imm @ rd @ 0b000000000010011,
  C20(rd, imm) <-> imm @ rd @ 0b000000000010100,
  C21(rd, imm) <-> imm @ rd @ 0b000000000010101,
  C22(rd, imm) <-> imm @ rd @ 0b000000000010110,
  C23(rd, imm) <-> imm @ rd @ 0b000000000010111,
  C24(rd, imm) <-> imm @ rd @ 0b000000000011000,
  C25(rd, imm) <-> imm @ rd @ 0b000000000011001,
  C26(rd, imm) <-> imm @ rd @ 0b000000000011010,
  C27(rd, imm) <-> imm @ rd @ 0b000000000011011,
  C28(rd, imm) <-> imm @ rd @ 0b000000000011100,
  C29(rd, imm) <-> imm @ rd @ 0b000000000011101,
  C30(rd, imm) <-> imm @ rd @ 0b000000000011110,
  C31(rd, imm) <-> imm @ rd @ 0b000000000011111,
  C32(rd, imm) <-> imm @ rd @ 0b000000000100000,
  C33(rd, imm) <-> imm @ rd @ 0b000000000100001,
  C34(rd, imm) <-> imm @ rd @ 0b000000000100010,
  C35(rd, imm) <-> imm @ rd @ 0b000000000100011,
  C36(rd, imm) <-> imm @ rd @ 0b000000000100100,
  C37(rd, imm) <-> imm @ rd @ 0b000000000100101,
  C38(rd, imm) <-> imm @ rd @ 0b000000000100110,
  C39(rd, imm) <-> imm @ rd @ 0b000000000100111,
  C40(rd, imm) <-> imm @ rd @ 0b000000000101000,
  C41(rd, imm) <-> imm @ rd @ 0b000000000101001,
  C42(rd, imm) <-> imm @ rd @ 0b000000000101010,
  C43(rd, imm) <-> imm @ rd @ 0b000000000101011,
  C44(rd, imm) <-> imm @ rd @ 0b000000000101100,
  C45(rd, imm) <-> imm @ rd @ 0b000000000101101,
  C46(rd, imm) <-> imm @ rd @ 0b000000000101110,
  C47(rd, imm) <-> imm @ rd @ 0b000000000101111,
  C48(rd, imm) <-> imm @ rd @ 0b000000000110000,
  C49(rd, imm) <-> imm @ rd @ 0b000000000110001,
  C50(rd, imm) <-> imm @ rd @ 0b000000000110010,
  C51(rd, imm) <-> imm @ rd @ 0b000000000110011,
  C52(rd, imm) <-> imm @ rd @ 0b000000000110100,
  C53(rd, imm) <-> imm @ rd @ 0b000000000110101,
  C54(rd, imm) <-> imm @ rd @ 0b000000000110110,
  C55(rd, imm) <-> imm @ rd @ 0b000000000110111,
  C56(rd, imm) <-> imm @ rd @ 0b000000000111000,
  C57(rd, imm) <-> imm @ rd @ 0b000000000111001,
  C58(rd, imm) <-> imm @ rd @ 0b000000000111010,
  C59(rd, imm) <-> imm @ rd @ 0b000000000111011
}

val decode : bits(32) -> ast
function decode(b) = encdec(b)
