default Order dec

$include <prelude.sail>

/*
  EqDec instances for larger types: generated by numbering the values of an enum,
  and by comparing a union's constructor tag and then its fields, instead of
  Derive EqDec (quadratic in the number of constructors). base.template.v checks
  that eq_dec computes on closed values.
*/
enum Big = {
  E0,
  E1,
  E2,
  E3,
  E4,
  E5,
  E6,
  E7,
  E8,
  E9,
  E10,
  E11,
  E12,
  E13,
  E14,
  E15,
  E16,
  E17,
  E18,
  E19,
  E20,
  E21,
  E22,
  E23,
  E24,
  E25,
  E26,
  E27,
  E28,
  E29,
  E30,
  E31,
  E32,
  E33,
  E34,
  E35,
  E36,
  E37,
  E38,
  E39,
  E40,
  E41,
  E42,
  E43,
  E44,
  E45,
  E46,
  E47,
  E48,
  E49,
  E50,
  E51,
  E52,
  E53,
  E54,
  E55,
  E56,
  E57,
  E58,
  E59
}

struct Pair = {
  first  : bits(8),
  second : bool,
}

union Small = {
  SmallA : unit,
  SmallB : Big,
}

union Instr = {
  I0 : unit,
  I1 : bits(5),
  I2 : (bits(5), bits(12)),
  I3 : Big,
  I4 : bool,
  I5 : int,
  I6 : Pair,
  I7 : Small,
  I8 : (Big, bits(3), bool),
  I9 : bits(32),
  I10 : unit,
  I11 : bits(5),
  I12 : (bits(5), bits(12)),
  I13 : Big,
  I14 : bool,
  I15 : int,
  I16 : Pair,
  I17 : Small,
  I18 : (Big, bits(3), bool),
  I19 : bits(32),
  I20 : unit,
  I21 : bits(5),
  I22 : (bits(5), bits(12)),
  I23 : Big,
  I24 : bool,
  I25 : int,
  I26 : Pair,
  I27 : Small,
  I28 : (Big, bits(3), bool),
  I29 : bits(32),
  I30 : unit,
  I31 : bits(5),
  I32 : (bits(5), bits(12)),
  I33 : Big,
  I34 : bool,
  I35 : int,
  I36 : Pair,
  I37 : Small,
  I38 : (Big, bits(3), bool),
  I39 : bits(32)
}

register r_big   : Big
register r_instr : Instr = I0()
register r_small : Small = SmallA()
register r_pair  : Pair = struct { first = 0x00, second = false }

val is_nop : Instr -> bool
function is_nop(i) = match i {
  I0()  => true,
  _     => false,
}

val big_of : Instr -> Big
function big_of(i) = match i {
  I3(b) => b,
  _     => E0,
}
