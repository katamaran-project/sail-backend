#!/usr/bin/env bash
# Runs every template test; exits with a non-zero status if any of them fails.

failed=()

for dir in $(./list-tests); do
    name="$(basename "$dir")"
    echo "Testing $name"
    if ! (cd "$dir" && ../test.sh); then
        echo "FAILED $name"
        failed+=("$name")
    fi
done

if (( ${#failed[@]} > 0 )); then
    echo "${#failed[@]} template test(s) failed: ${failed[*]}"
    exit 1
fi
